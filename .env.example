# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional chat model override when the default model is unavailable.
# GEMINI_CHAT_MODEL="gemini-3-flash-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Supabase project used by the source learning project.
# Only the publishable key may be exposed to Vite/browser code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Optional persistent directory for private device data and uploaded media.
# Default: ./data (Bun SQLite). Mount a persistent volume here in production.
# KVTT_DATA_DIR="./data"

# Teacher accounts use the existing login cookie and a server-managed teacher role.
# Provision once with scripts/seed-teacher-account.ts; pass password privately via stdin.
# Never put a teacher password or database service key in VITE_* variables.
# Personalized cloud AI stays disabled until its data-processing policy is approved.
# KVTT_PERSONAL_DATA_AI_APPROVED="false"
